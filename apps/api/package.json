{
  "name": "@kotzoeker/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API van Kotzoeker: auth, koten, foto's. Enige component die met de database en de opslag praat.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "jest --config ./jest-e2e.config.ts --runInBand",
    "db:seed": "tsx --env-file-if-exists=.env src/database/seed.ts"
  },
  "packageManager": "pnpm@10.18.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@kotzoeker/db": "workspace:*",
    "@kotzoeker/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "argon2": "^0.45.1",
    "drizzle-orm": "catalog:",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kotzoeker/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "webpack": "^5.111.1",
    "webpack-node-externals": "^3.0.0"
  }
}
